# Nexa POS — device configuration file
#
# Copy this file to:
#   Windows: C:\Users\<YourName>\AppData\Roaming\Nexa POS\nexapos.env
#
# Each device (branch location) gets its own copy with BRANCH_ID set
# to the ID of the branch that machine serves.
# Without BRANCH_ID, cloud sync will pull all branches — not recommended.

# --- Required for cloud sync ---
# Get the branch ID from the Nexa POS web admin:
#   Settings → Branches → click your branch → copy the ID from the URL
BRANCH_ID=

# URL of the cloud deployment (Vercel or your own host)
CLOUD_API_URL=https://your-app.vercel.app

# Bearer token of a super_admin user on the cloud
# Log in as super_admin, open DevTools → Application → Local Storage,
# find the "token" key and copy its value.
CLOUD_SYNC_TOKEN=
