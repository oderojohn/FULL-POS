VITE_POS_API_URL=http://127.0.0.1:8010/api/pos
VITE_INVENTORY_API_URL=http://127.0.0.1:8010/api/inventory

DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
SECRET_KEY=change-me
DEBUG=False
USE_SQLITE=False
ALLOWED_HOSTS=example.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://example.com
CORS_ALLOWED_ORIGINS=https://frontend.example.com,http://127.0.0.1:5173,http://localhost:5173
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Desktop Electron sync — connect the offline POS to this cloud backend
# CLOUD_API_URL: base URL of your deployed backend (no trailing slash)
# CLOUD_SYNC_TOKEN: bearer token of a super_admin user on the cloud
# BRANCH_ID: restrict this device to one branch (recommended in production)
CLOUD_API_URL=https://your-backend.railway.app
CLOUD_SYNC_TOKEN=
BRANCH_ID=

# Email — required for scheduled report delivery
# Use smtp.EmailBackend for real sending, console.EmailBackend for development
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Nexa POS <your-email@gmail.com>
